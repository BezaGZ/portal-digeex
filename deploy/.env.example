# Variables del stack. Cada servidor tiene su propio .env; esto es la plantilla.

# Dominio y URLs publicas.
DSPACE_SERVER_URL=https://digeex-ensayo.duckdns.org/server
DSPACE_UI_URL=https://digeex-ensayo.duckdns.org
DSPACE_NAME=Portal de Gestion del Conocimiento DIGEEX

# Correo saliente (SMTP). Por defecto el compose apunta a Resend; para el
# Sandbox de Mailtrap se sobreescriben estas variables en el .env del servidor.
#
#   Resend:   MAIL_HOST y MAIL_USER vacios (toman su default); MAIL_PASSWORD =
#             la API key de Resend; MAIL_FROM = onboarding@resend.dev.
#   Mailtrap Sandbox (prueba a cualquier correo, cae en la bandeja web):
#             MAIL_HOST=sandbox.smtp.mailtrap.io, MAIL_USER y MAIL_PASSWORD =
#             credenciales del sandbox, MAIL_PORT=587, MAIL_FROM = cualquiera.

# Servidor SMTP. Vacio = smtp.resend.com (default del compose).
MAIL_HOST=
# Usuario SMTP. Vacio = resend (default). En Mailtrap, el del sandbox.
MAIL_USER=
# Contrasena SMTP. Obligatoria, sin default. Resend: la API key. Mailtrap: la del sandbox.
MAIL_PASSWORD=
# Puerto SMTP. Vacio = 587.
MAIL_PORT=
# Direccion "de". Para Resend debe ser onboarding@resend.dev; en Mailtrap, cualquiera.
MAIL_FROM=onboarding@resend.dev
# A donde DSpace manda los avisos de admin (y el destino del test-email).
MAIL_ADMIN=admin@mineduc.gob.gt

# Base de datos.
POSTGRES_PASSWORD=

# Primer superadmin.
ADMIN_EMAIL=admin@mineduc.gob.gt
ADMIN_PASSWORD=
ADMIN_FIRSTNAME=Admin
ADMIN_LASTNAME=DIGEEX
ADMIN_LANGUAGE=es
