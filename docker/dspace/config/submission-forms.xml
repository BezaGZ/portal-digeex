<?xml version="1.0" encoding="UTF-8"?>
<!--
  submission-forms.xml — Fragmentos DIGEEX

  Este archivo contiene SOLO los bloques que el portal DIGEEX agrega
  al submission-forms.xml oficial de DSpace 9.x.

  En desarrollo: backend/dspace/config/submission-forms.xml ya tiene
  estos bloques inyectados; el contenedor lee directamente de ahí
  vía bind mount declarado en backend/docker-compose.yml.

  En producción: este archivo sirve como referencia del delta DIGEEX
  para el script de inyección que haga merge con el submission-forms.xml
  stock.

  NOTA: Este XML no es procesable por sí solo (es un fragmento documental,
  no tiene la raíz <input-forms>).
-->


<!-- =========================================================================
  Bloque 1 — Tres <form> DIGEEX (formularios de submission por tipo de contenido)

  Va dentro de <form-definitions>
  Después del último <form name="orgUnit"> stock
  Antes del cierre </form-definitions>
  ========================================================================= -->

<!-- DIGEEX submission form: Galería (F-04) -->
<form name="digeex-galeria">
    <row>
        <field>
            <dc-schema>dc</dc-schema>
            <dc-element>title</dc-element>
            <repeatable>false</repeatable>
            <label>Título del álbum</label>
            <input-type>onebox</input-type>
            <hint>Nombre con el que se identifica el álbum en el portal.</hint>
            <required>El título es obligatorio.</required>
        </field>
    </row>
    <row>
        <field>
            <dc-schema>dc</dc-schema>
            <dc-element>description</dc-element>
            <dc-qualifier>abstract</dc-qualifier>
            <repeatable>false</repeatable>
            <label>Descripción</label>
            <input-type>textarea</input-type>
            <hint>Resumen del álbum para mostrar en el listado público.</hint>
            <required></required>
        </field>
    </row>
    <row>
        <field>
            <dc-schema>dc</dc-schema>
            <dc-element>date</dc-element>
            <dc-qualifier>issued</dc-qualifier>
            <repeatable>false</repeatable>
            <label>Fecha</label>
            <input-type>date</input-type>
            <hint>Fecha en la que se realizó el evento o se tomaron las fotografías.</hint>
            <required>La fecha es obligatoria.</required>
        </field>
    </row>
    <row>
        <field>
            <dc-schema>dc</dc-schema>
            <dc-element>type</dc-element>
            <repeatable>false</repeatable>
            <label>Tipo de evento</label>
            <input-type value-pairs-name="tipos-evento">dropdown</input-type>
            <hint>Tipo de evento o actividad documentada en el álbum.</hint>
            <required>El tipo de evento es obligatorio.</required>
        </field>
    </row>
    <row>
        <field>
            <dc-schema>dc</dc-schema>
            <dc-element>contributor</dc-element>
            <dc-qualifier>author</dc-qualifier>
            <repeatable>true</repeatable>
            <label>Autor</label>
            <input-type>onebox</input-type>
            <hint>Persona o equipo que tomó las fotografías.</hint>
            <required></required>
        </field>
    </row>
    <row>
        <field>
            <dc-schema>dc</dc-schema>
            <dc-element>subject</dc-element>
            <dc-qualifier>classification</dc-qualifier>
            <repeatable>false</repeatable>
            <label>Programa</label>
            <input-type value-pairs-name="programas-digeex">dropdown</input-type>
            <hint>Programa DIGEEX al que pertenece el álbum.</hint>
            <required>El programa es obligatorio.</required>
        </field>
    </row>
    <row>
        <field>
            <dc-schema>digeex</dc-schema>
            <dc-element>populationType</dc-element>
            <repeatable>false</repeatable>
            <label>Tipo de población predominante</label>
            <input-type value-pairs-name="tipo-poblacion">dropdown</input-type>
            <hint>Población predominante en las fotografías.</hint>
            <required></required>
        </field>
    </row>
    <row>
        <field>
            <dc-schema>digeex</dc-schema>
            <dc-element>imageFocus</dc-element>
            <repeatable>false</repeatable>
            <label>Enfoque visual</label>
            <input-type value-pairs-name="enfoque-imagen">dropdown</input-type>
            <hint>Contexto visual del álbum.</hint>
            <required></required>
        </field>
    </row>
</form>

<!-- DIGEEX submission form: Documento (F-03 + F-06 video como toggle frontend) -->
<form name="digeex-documento">
    <row>
        <field>
            <dc-schema>dc</dc-schema>
            <dc-element>title</dc-element>
            <repeatable>false</repeatable>
            <label>Título</label>
            <input-type>onebox</input-type>
            <hint>Título del documento o video.</hint>
            <required>El título es obligatorio.</required>
        </field>
    </row>
    <row>
        <field>
            <dc-schema>dc</dc-schema>
            <dc-element>description</dc-element>
            <dc-qualifier>abstract</dc-qualifier>
            <repeatable>false</repeatable>
            <label>Descripción</label>
            <input-type>textarea</input-type>
            <hint>Resumen del recurso para el listado público.</hint>
            <required></required>
        </field>
    </row>
    <row>
        <field>
            <dc-schema>dc</dc-schema>
            <dc-element>type</dc-element>
            <repeatable>false</repeatable>
            <label>Tipo</label>
            <input-type value-pairs-name="tipos-documento">dropdown</input-type>
            <hint>Tipo de documento. El frontend fija "Video" cuando el toggle de video está activo.</hint>
            <required>El tipo es obligatorio.</required>
        </field>
    </row>
    <row>
        <field>
            <dc-schema>dc</dc-schema>
            <dc-element>audience</dc-element>
            <repeatable>false</repeatable>
            <label>Nivel educativo</label>
            <input-type value-pairs-name="niveles-educativos">dropdown</input-type>
            <hint>Audiencia destinataria del recurso.</hint>
            <required></required>
        </field>
    </row>
    <row>
        <field>
            <dc-schema>dc</dc-schema>
            <dc-element>date</dc-element>
            <dc-qualifier>issued</dc-qualifier>
            <repeatable>false</repeatable>
            <label>Fecha de publicación</label>
            <input-type>date</input-type>
            <hint>Fecha de publicación del recurso.</hint>
            <required>La fecha es obligatoria.</required>
        </field>
    </row>
    <row>
        <field>
            <dc-schema>dc</dc-schema>
            <dc-element>contributor</dc-element>
            <dc-qualifier>author</dc-qualifier>
            <repeatable>true</repeatable>
            <label>Autor</label>
            <input-type>onebox</input-type>
            <hint>Persona o equipo responsable del recurso.</hint>
            <required></required>
        </field>
    </row>
    <row>
        <field>
            <dc-schema>dc</dc-schema>
            <dc-element>publisher</dc-element>
            <repeatable>false</repeatable>
            <label>Publicado por</label>
            <input-type>onebox</input-type>
            <hint>Subdirección o entidad que publica el recurso (opcional).</hint>
            <required></required>
        </field>
    </row>
    <row>
        <field>
            <dc-schema>dc</dc-schema>
            <dc-element>subject</dc-element>
            <repeatable>true</repeatable>
            <label>Palabras clave</label>
            <input-type>tag</input-type>
            <hint>Palabras clave que describen el contenido.</hint>
            <required></required>
        </field>
    </row>
    <row>
        <field>
            <dc-schema>dc</dc-schema>
            <dc-element>language</dc-element>
            <dc-qualifier>iso</dc-qualifier>
            <repeatable>false</repeatable>
            <label>Idioma</label>
            <input-type value-pairs-name="idiomas-digeex">dropdown</input-type>
            <hint>Idioma del recurso. La lista incluye español, los 22 idiomas mayas, garífuna, xinka y los principales internacionales.</hint>
            <required></required>
        </field>
    </row>
    <row>
        <field>
            <dc-schema>dc</dc-schema>
            <dc-element>relation</dc-element>
            <dc-qualifier>uri</dc-qualifier>
            <repeatable>false</repeatable>
            <label>URL del video externo</label>
            <input-type>onebox</input-type>
            <hint>URL de YouTube o Google Drive. El frontend muestra este campo solo si el toggle de video está activo.</hint>
            <required></required>
        </field>
    </row>
</form>

<!-- DIGEEX submission form: Estadística (F-05) -->
<form name="digeex-estadistica">
    <row>
        <field>
            <dc-schema>dc</dc-schema>
            <dc-element>title</dc-element>
            <repeatable>false</repeatable>
            <label>Título de la gráfica</label>
            <input-type>onebox</input-type>
            <hint>Etiqueta que aparece sobre la gráfica cuando el portal renderiza las estadísticas.</hint>
            <required>El título es obligatorio.</required>
        </field>
    </row>
    <row>
        <field>
            <dc-schema>dc</dc-schema>
            <dc-element>description</dc-element>
            <dc-qualifier>abstract</dc-qualifier>
            <repeatable>false</repeatable>
            <label>Descripción</label>
            <input-type>textarea</input-type>
            <hint>Contexto de los datos de la gráfica.</hint>
            <required></required>
        </field>
    </row>
    <row>
        <field>
            <dc-schema>dc</dc-schema>
            <dc-element>date</dc-element>
            <dc-qualifier>issued</dc-qualifier>
            <repeatable>false</repeatable>
            <label>Fecha</label>
            <input-type>date</input-type>
            <hint>Fecha o período al que corresponden los datos.</hint>
            <required>La fecha es obligatoria.</required>
        </field>
    </row>
</form>


<!-- =========================================================================
