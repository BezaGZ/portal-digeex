<?xml version="1.0" encoding="UTF-8"?>
<!--
  Discovery Configuration — Portal DIGEEX (Producción)

  Este archivo contiene SOLO los beans custom de DIGEEX que se deben
  inyectar al discovery.xml oficial de DSpace en el despliegue.

  En desarrollo: backend/dspace/config/ se monta directo al contenedor.
  En producción: este archivo se inyecta al contenedor via entrypoint o
  script de inicialización que haga merge con el discovery.xml oficial.

  Después de cualquier cambio en beans:
    1. docker compose -p d9 restart dspace
    2. docker exec -it dspace /dspace/bin/dspace index-discovery -b
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- ====== DIGEEX custom filters ====== -->

    <!-- Idioma (Búsqueda Avanzada — Form 1) -->
    <bean id="searchFilterLanguage" class="org.dspace.discovery.configuration.DiscoverySearchFilterFacet">
        <property name="indexFieldName" value="language"/>
        <property name="metadataFields">
            <list>
                <value>dc.language.iso</value>
            </list>
        </property>
        <property name="facetLimit" value="10"/>
        <property name="sortOrderSidebar" value="COUNT"/>
        <property name="sortOrderFilterPage" value="COUNT"/>
    </bean>

    <!-- Nivel educativo (Búsqueda Avanzada — Form 1) -->
    <bean id="searchFilterAudience" class="org.dspace.discovery.configuration.DiscoverySearchFilterFacet">
        <property name="indexFieldName" value="audience"/>
        <property name="metadataFields">
            <list>
                <value>dc.audience</value>
            </list>
        </property>
        <property name="facetLimit" value="5"/>
        <property name="sortOrderSidebar" value="COUNT"/>
        <property name="sortOrderFilterPage" value="COUNT"/>
    </bean>

    <!-- Tipo de población (Galería — Form 2) -->
    <bean id="searchFilterSponsorship" class="org.dspace.discovery.configuration.DiscoverySearchFilterFacet">
        <property name="indexFieldName" value="sponsorship"/>
        <property name="metadataFields">
            <list>
                <value>dc.description.sponsorship</value>
            </list>
        </property>
        <property name="facetLimit" value="10"/>
        <property name="sortOrderSidebar" value="COUNT"/>
        <property name="sortOrderFilterPage" value="COUNT"/>
    </bean>

    <!-- Enfoque de imagen (Galería — Form 2) -->
    <bean id="searchFilterSpatial" class="org.dspace.discovery.configuration.DiscoverySearchFilterFacet">
        <property name="indexFieldName" value="spatial"/>
        <property name="metadataFields">
            <list>
                <value>dc.coverage.spatial</value>
            </list>
        </property>
        <property name="facetLimit" value="5"/>
        <property name="sortOrderSidebar" value="COUNT"/>
        <property name="sortOrderFilterPage" value="COUNT"/>
    </bean>

    <!-- Programa / Clasificación (Galería — Form 2) -->
    <bean id="searchFilterClassification" class="org.dspace.discovery.configuration.DiscoverySearchFilterFacet">
        <property name="indexFieldName" value="classification"/>
        <property name="metadataFields">
            <list>
                <value>dc.subject.classification</value>
            </list>
        </property>
        <property name="facetLimit" value="10"/>
        <property name="sortOrderSidebar" value="COUNT"/>
        <property name="sortOrderFilterPage" value="COUNT"/>
    </bean>

    <!-- Formato de colección — filtro implícito para excluir galería/estadísticas -->
    <bean id="searchFilterFormat" class="org.dspace.discovery.configuration.DiscoverySearchFilterFacet">
        <property name="indexFieldName" value="format"/>
        <property name="metadataFields">
            <list>
                <value>dc.format</value>
            </list>
        </property>
        <property name="facetLimit" value="5"/>
        <property name="sortOrderSidebar" value="COUNT"/>
        <property name="sortOrderFilterPage" value="COUNT"/>
    </bean>

    <!-- ====== End DIGEEX custom filters ====== -->

    <!--
      IMPORTANTE — En producción estos beans deben registrarse
      en defaultConfiguration dentro de dos listas:

      1. sidebarFacets:
         <ref bean="searchFilterType" />
         <ref bean="searchFilterLanguage" />
         <ref bean="searchFilterAudience" />
         <ref bean="searchFilterSponsorship" />
         <ref bean="searchFilterSpatial" />
         <ref bean="searchFilterClassification" />
         <ref bean="searchFilterFormat" />

      2. searchFilters:
         <ref bean="searchFilterType" />
         <ref bean="searchFilterLanguage" />
         <ref bean="searchFilterAudience" />
         <ref bean="searchFilterSponsorship" />
         <ref bean="searchFilterSpatial" />
         <ref bean="searchFilterClassification" />
         <ref bean="searchFilterFormat" />

      Estrategia de inyección (pendiente Sprint 5):
        - Opción A: sed/xmlstarlet en entrypoint para insertar beans
          en el discovery.xml oficial antes de arrancar Tomcat
        - Opción B: Montar este archivo como override de Spring y
          usar import en el discovery.xml oficial
        - Opción C: Copiar el discovery.xml completo (con beans
          oficiales + DIGEEX) como volumen montado
    -->

</beans>
