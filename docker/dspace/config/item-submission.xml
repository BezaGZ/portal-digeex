<?xml version="1.0" encoding="UTF-8"?>
<!--
  item-submission.xml — Fragmentos DIGEEX

  Este archivo contiene SOLO los bloques que el portal DIGEEX agrega
  al item-submission.xml oficial de DSpace 9.x.

  En desarrollo: backend/dspace/config/item-submission.xml ya tiene
  estos bloques inyectados; el contenedor lee directamente de ahí
  vía bind mount declarado en backend/docker-compose.yml.

  En producción: este archivo sirve como referencia del DIGEEX
  para el script de inyección que haga merge con el item-submission.xml
  stock.

  NOTA: Este XML no es procesable por sí solo (es un fragmento documental,
  no tiene la raíz <item-submission>).
-->


<!-- =========================================================================
  Bloque 1 — Tres <name-map> por collection-entity-type

  Va dentro de <submission-map>
  Después del último <name-map collection-entity-type="JournalIssue"> stock
  y del comentario de ejemplo de community-handle
  Antes del cierre </submission-map>
  ========================================================================= -->

<!-- DIGEEX submission processes mapped by collection entity-type -->
<name-map collection-entity-type="Documento" submission-name="digeex-documento"/>
<name-map collection-entity-type="Galeria" submission-name="digeex-galeria"/>
<name-map collection-entity-type="Estadistica" submission-name="digeex-estadistica"/>


<!-- =========================================================================
  Bloque 2 — Tres <step-definition> (envoltura de cada form como step)

  Va dentro de <step-definitions>
  Después del último <step-definition id="duplicates"> stock
  Antes del cierre </step-definitions>

  El id de cada step coincide con el name del form correspondiente
  declarado en submission-forms.xml.
  ========================================================================= -->

<!-- DIGEEX step-definitions: cada id coincide con el form name en submission-forms.xml -->
<step-definition id="digeex-documento" mandatory="true">
    <heading>submit.progressbar.describe.stepone</heading>
    <processing-class>org.dspace.app.rest.submit.step.DescribeStep</processing-class>
    <type>submission-form</type>
</step-definition>
<step-definition id="digeex-galeria" mandatory="true">
    <heading>submit.progressbar.describe.stepone</heading>
    <processing-class>org.dspace.app.rest.submit.step.DescribeStep</processing-class>
    <type>submission-form</type>
</step-definition>
<step-definition id="digeex-estadistica" mandatory="true">
    <heading>submit.progressbar.describe.stepone</heading>
    <processing-class>org.dspace.app.rest.submit.step.DescribeStep</processing-class>
    <type>submission-form</type>
</step-definition>


<!-- =========================================================================
  Bloque 3 — Tres <submission-process> (orquestación de pasos por tipo)

  Va dentro de <submission-definitions>
  Después del último <submission-process name="openaireOrganizationSubmission">
  Antes del cierre </submission-definitions>

  La cadena para los tres es: collection -> describe -> upload -> license.
  ========================================================================= -->

<!-- DIGEEX submission processes: collection -> describe -> upload -> license -->
<submission-process name="digeex-documento">
    <step id="collection"/>
    <step id="digeex-documento"/>
    <step id="upload"/>
    <step id="license"/>
</submission-process>
<submission-process name="digeex-galeria">
    <step id="collection"/>
    <step id="digeex-galeria"/>
    <step id="upload"/>
    <step id="license"/>
</submission-process>
<submission-process name="digeex-estadistica">
    <step id="collection"/>
    <step id="digeex-estadistica"/>
    <step id="upload"/>
    <step id="license"/>
</submission-process>
