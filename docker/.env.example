# DSpace REST API
DSPACE_REST_URL=http://localhost:8080/server

# Cuenta de administrador (RN-01). El entrypoint la crea de forma idempotente
# con create-administrator; los cinco campos son obligatorios (sin ADMIN_LANGUAGE
# el comando cae a modo interactivo y cuelga el arranque).
ADMIN_EMAIL=admin@mineduc.gob.gt
ADMIN_PASSWORD=admin123
ADMIN_FIRSTNAME=Admin
ADMIN_LASTNAME=DIGEEX
ADMIN_LANGUAGE=es

# Password compartido por los 6 seed users de subdirecciones
# (admin_subdireccion y personal_delegado de cada subdireccion).
# En produccion cada usuario lo cambia al primer login.
SEED_PASSWORD=digeex123